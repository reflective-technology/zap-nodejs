{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2025",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "nodenext"
  },
  "include": ["src", "tests"]
}
