{
  "name": "@reflective-technology/zap-nodejs",
  "version": "3.2.0",
  "description": "A lightweight Node.js logger with structured logging and Express middleware, designed to match the format and philosophy of go.uber.org/zap.",
  "license": "MIT",
  "author": "Reflective Technology RD Team <rd@zuin.ai> (https://www.zuin.ai)",
  "main": "dist/cjs/index.js",
  "module": "dist/es/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "logger",
    "logging",
    "zap",
    "structured-logging",
    "middleware",
    "express"
  ],
  "homepage": "https://github.com/reflective-technology/zap-nodejs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reflective-technology/zap-nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/reflective-technology/zap-nodejs/issues"
  },
  "scripts": {
    "build": "rm -rf dist/cjs && rollup -c && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist/types",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "eslint": "eslint --fix \"{src,test}/**/*.ts\""
  },
  "engines": {
    "node": "20.x || 22.x || 24.x || 26.x"
  },
  "dependencies": {
    "on-finished": "^2.4.1",
    "on-headers": "^1.1.0"
  },
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.1.0",
    "@types/on-finished": "^2.3.5",
    "@types/on-headers": "^1.0.4",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "rollup": "^4.52.4",
    "rollup-plugin-dts": "^6.2.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "provenance": true
  }
}
